{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["src/ui/**/*.ts", "src/ui/**/*.tsx", "vite.config.ts"]
}
