{
  "name": "fritzkit",
  "version": "0.1.0",
  "description": "Compile a JSON part spec into first-class Fritzing parts: CLI, MCP server and Claude Code skill",
  "license": "MIT",
  "author": "Max Hogan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmaxhogan/fritzkit.git"
  },
  "homepage": "https://github.com/pmaxhogan/fritzkit#readme",
  "bugs": "https://github.com/pmaxhogan/fritzkit/issues",
  "keywords": [
    "fritzing",
    "fzpz",
    "parts",
    "breadboard",
    "mcp",
    "claude-code"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "fritzkit": "dist/cli/main.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": "./dist/core/index.js",
    "./schema": "./dist/core/schema/part.schema.json"
  },
  "files": [
    "dist",
    "skills",
    ".claude-plugin",
    "tools/fzp-checker/pyproject.toml",
    "tools/fzp-checker/uv.lock",
    "tools/fzp-checker/check_fzp.py",
    "tools/fzp-checker/.python-version",
    "tools/fzp-checker/README.md",
    "tools/fzp-checker/vendor",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs && npm run ui:build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-ascii": "node scripts/check-ascii.mjs",
    "test": "vitest run --coverage --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=cobertura",
    "test:watch": "vitest",
    "e2e": "node --import tsx scripts/e2e/run.ts",
    "fritzkit": "node --import tsx src/cli/main.ts",
    "prepack": "npm run build",
    "gen-schema": "node --import tsx scripts/gen-schema.ts",
    "ui:dev": "vite",
    "ui:build": "tsc -p tsconfig.ui.json --noEmit && vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
