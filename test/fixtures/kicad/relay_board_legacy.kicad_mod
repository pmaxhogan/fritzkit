(module Relay_Board_3pin (layer F.Cu) (tedit 5A02FE0E)
  (descr "Generic relay module board, 3 pin screw terminal, one M3 mounting hole")
  (tags "relay module")
  (fp_text reference REF** (at 0 -2) (layer F.SilkS)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value Relay_Board_3pin (at 10 17) (layer F.Fab)
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_line (start -5 -5) (end 25 -5) (layer Edge.Cuts) (width 0.15))
  (fp_line (start 25 -5) (end 25 15) (layer Edge.Cuts) (width 0.15))
  (fp_line (start 25 15) (end -5 15) (layer Edge.Cuts) (width 0.15))
  (fp_line (start -5 15) (end -5 -5) (layer Edge.Cuts) (width 0.15))
  (fp_line (start -4.5 -4.5) (end 24.5 -4.5) (layer F.SilkS) (width 0.12))
  (fp_arc (start 0 10) (end 2 10) (angle 90) (layer F.SilkS) (width 0.12))
  (fp_circle (center 20 10) (end 21.6 10) (layer F.Fab) (width 0.1))
  (pad 1 thru_hole rect (at 0 0) (size 2 2) (drill 1.2) (layers *.Cu *.Mask))
  (pad 2 thru_hole circle (at 5.08 0) (size 2 2) (drill 1.2) (layers *.Cu *.Mask))
  (pad 3 thru_hole circle (at 10.16 0) (size 2 2) (drill 1.2) (layers *.Cu *.Mask))
  (pad "" np_thru_hole circle (at 20 10) (size 3.2 3.2) (drill 3.2) (layers *.Cu *.Mask))
  (model ${KISYS3DMOD}/Relay.3dshapes/Relay_Board.wrl
    (at (xyz 0 0 0))
    (scale (xyz 1 1 1))
    (rotate (xyz 0 0 0))
  )
)
